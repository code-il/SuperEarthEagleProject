# SPHEREx Explorer configuration. Copy to .env (never commit .env).
# No credentials are needed: IRSA, CDS, Gaia and SkyBoT are public, anonymous services.
# scripts/start.py reads .env; with plain uvicorn, export these variables yourself.

# --- server ---------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
# Also write a rotating log file (5 MB x 3)
SPHEREX_LOG_FILE=logs/api.log
# Origins allowed to call the API from another domain (only when the viewer is hosted elsewhere)
CORS_ORIGINS=http://localhost:5173
# Serve a built viewer from a non-default folder
# SPHEREX_FRONTEND_DIST=frontend/dist

# --- request limits (protect IRSA and the server) ---------------------------
# Archive/processing requests per client per minute (0 = off)
SPHEREX_RATE_LIMIT_PER_MIN=120
# Heavy jobs (process/compare/analysis) running at once; others queue
SPHEREX_MAX_CONCURRENT_JOBS=3
# How long a queued heavy job waits before a 503 "busy, retry"
SPHEREX_JOB_QUEUE_TIMEOUT_S=300
# Use X-Forwarded-For for the client address (only behind a trusted reverse proxy)
# SPHEREX_TRUST_PROXY=1

# --- data and caching ---------------------------------------------------------
# Where cutouts, processed frames, calibration files and query results are kept
SPHEREX_CACHE_DIR=cache
# How long archive query results are reused (s)
SPHEREX_QUERY_CACHE_TTL_S=21600
SPHEREX_MAX_FOV_DEG=2.0
SPHEREX_MAX_CUTOUTS_PER_REQUEST=400
SPHEREX_HTTP_TIMEOUT_S=120
SPHEREX_HTTP_RETRIES=6
SPHEREX_MAX_WORKERS=6
# Releases searched by default (DR1 and QR3 are one uniformly processed set)
SPHEREX_DEFAULT_RELEASES=DR1,QR3
# Per-pixel wavelengths from the release-matched CWAVE/CBAND calibration (1) or WCS-WAVE (0)
SPHEREX_USE_SPECTRAL_WCS_CAL=1
